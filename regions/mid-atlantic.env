# Region: Mid-Atlantic
# New Jersey, New York, Pennsylvania, Maryland, Delaware, and Washington DC.
# DC is included because it sits inside Maryland. Without it the map has a hole.
#
# Build everything with:
#   ./scripts/build-region.sh regions/mid-atlantic.env

# Short name. Used for the merged OSM file in data/sources.
REGION_NAME="mid-atlantic"

# Geofabrik extract paths (see https://download.geofabrik.de).
GEOFABRIK_AREAS="
north-america/us/new-jersey
north-america/us/new-york
north-america/us/pennsylvania
north-america/us/maryland
north-america/us/delaware
north-america/us/district-of-columbia
"

# Terrain bounding box: min-lon min-lat max-lon max-lat.
# It covers all six areas with a small margin.
# Contours and hillshade fill the whole box, including the parts of
# neighbouring states and Canada inside it. Roads and labels come only
# from the areas above.
BBOX="-80.6 37.8 -71.8 45.1"

# Contour units: ft or m.
CONTOUR_UNITS="ft"

# Java heap for Planetiler.
PLANETILER_MEMORY="8g"
