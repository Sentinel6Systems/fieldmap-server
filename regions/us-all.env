# Region: all 50 states and Washington DC, Alaska's Aleutians on both sides of
# the 180° line included, on top of the world layer: the whole world at zoom
# 0-8, the US from zoom 9 to 14. Labels in English only, to save space.
# Puerto Rico and the other territories are not in this Geofabrik extract.
#
# Build the full set (base map, contours, hillshade, elevation, extras), then
# the US federal data for the print styles:
#   ./scripts/build-region.sh regions/us-all.env
#   ./scripts/build-usdata.sh regions/us-all.env
#
# BBOX crosses the 180° line (min-lon larger than max-lon). The terrain covers
# the US outline inside it on both sides; the base map, extras and US data take
# the wider side, so they stop at 180° (the Near Islands west of it have
# terrain but no roads or labels).

# Short name. Used for the merged OSM file in data/sources.
REGION_NAME="us-all"

# Geofabrik extract path (see https://download.geofabrik.de).
GEOFABRIK_AREAS="
north-america/us
"

# Bounding box: min-lon min-lat max-lon max-lat. Wide enough for the whole
# US outline; the terrain is clipped to the outline, so no Canada or Mexico.
BBOX="170.5 15.5 -66.5 73.5"

# World layer for zoom 0-8, and labels in English only.
WORLD="yes"
LANGUAGE="en"

# Highest zoom of the elevation tiles for the print tool's terrain analysis.
ELEVATION_MAXZOOM="12"

# Contour units: ft or m.
CONTOUR_UNITS="ft"

# Two-letter codes for build-usdata.sh (GNIS names, NGS survey marks).
US_STATES="AL AK AZ AR CA CO CT DE DC FL GA HI ID IL IN IA KS KY LA ME MD MA MI MN MS MO MT NE NV NH NJ NM NY NC ND OH OK OR PA RI SC SD TN TX UT VT VA WA WV WI WY"

# Java heap for Planetiler.
PLANETILER_MEMORY="24g"
