# Region: the contiguous United States (lower 48 states and Washington DC),
# on top of the world layer: the whole world at zoom 0-8, the US from zoom 9.
# Labels in English only, to save space.
#
# Build everything with:
#   ./scripts/build-region.sh regions/us-lower48.env
# Optional layers:
#   ./scripts/build-region.sh regions/us-lower48.env extras
#   ./scripts/build-usdata.sh regions/us-lower48.env
#
# Sizes (approximate): OSM extract about 11 GB to download; basemap about 12 GB
# with the world layer; contours about 15 GB; hillshade about 37 GB as PNG to
# z13 (tools/hillshade-webp.py brings it to a few GB). The world layer needs
# about 160 GB of free disk the first time it is built. Allow a day for the
# whole build on a fast machine with 32 GB of RAM.
#
# Alaska, Hawaii and the territories are outside this box. They need their own
# region files (Alaska crosses the antimeridian, so its box must stop at 180°W).

# Short name. Used for the merged OSM file in data/sources.
REGION_NAME="us-lower48"

# Geofabrik extract path (see https://download.geofabrik.de). The US extract
# includes Alaska and Hawaii; BBOX below limits the output to the lower 48.
GEOFABRIK_AREAS="
north-america/us
"

# Terrain bounding box: min-lon min-lat max-lon max-lat.
BBOX="-125.0 24.4 -66.9 49.5"

# World layer for zoom 0-8, and labels in English only.
WORLD="yes"
LANGUAGE="en"

# Highest zoom of the elevation tiles for the print tool's terrain analysis:
# 12 is about 30 m per pixel here, 11 about 60 m and about a quarter of the size.
ELEVATION_MAXZOOM="12"

# Contour units: ft or m.
CONTOUR_UNITS="ft"

# Two-letter codes for build-usdata.sh (GNIS names, NGS survey marks).
US_STATES="AL AZ AR CA CO CT DE DC FL GA ID IL IN IA KS KY LA ME MD MA MI MN MS MO MT NE NV NH NJ NM NY NC ND OH OK OR PA RI SC SD TN TX UT VT VA WA WV WI WY"

# Java heap for Planetiler.
PLANETILER_MEMORY="24g"
