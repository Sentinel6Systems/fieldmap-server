# Copy this file to .env and change the values if you need to.

# Host port for the web front (print tool at /print/, tile server behind it).
WEB_PORT=80

# Host port for direct access to TileServer GL (TAK raster tiles etc.).
TILESERVER_PORT=8080

# Server configuration file.
# config.json = all five styles. It needs all three mbtiles files.
# config-basic.json = osm and overlay only. It needs only basemap.mbtiles.
TILESERVER_CONFIG=config.json

# TileServer GL image. The full image renders raster tiles for TAK clients.
# On a Raspberry Pi or a small box, use maptiler/tileserver-gl-light:latest
# with pi/tileserver/config-pi.json (no server-side rendering).
TILESERVER_IMAGE=maptiler/tileserver-gl:latest
