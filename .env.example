# Copy this file to .env and change the values if you need to.

# Host port for the web front (map printer at /mapprinter/, tile server behind it).
WEB_PORT=80

# Host port for direct access to TileServer GL (TAK raster tiles etc.).
TILESERVER_PORT=8080

# Server configuration file.
# config.json = all five styles. It needs all three mbtiles files.
# config-basic.json = osm and overlay only. It needs only basemap.mbtiles.
TILESERVER_CONFIG=config.json

# TileServer GL image, built for both x86 (amd64) and ARM (arm64, e.g. a Raspberry Pi
# on 64-bit Raspberry Pi OS). The full image renders the raster tiles TAK clients use.
TILESERVER_IMAGE=maptiler/tileserver-gl:v5.7.0

# Most memory the tile server may use (no swap on top). Raster tiles for TAK clients are what
# use it; past this, Docker restarts the tile server instead of letting it starve the machine.
# scripts/mem-limit.sh sets this from the machine's RAM: 1g under 8 GB, 0 (no cap) at 8 GB or
# more. Uncomment to choose yourself. Without a value, the cap is 1g.
# TILESERVER_MEM_LIMIT=1g
