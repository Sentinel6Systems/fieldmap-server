# Copy this file to .env and change the values if you need to.

# Host port for the web front (map printer at /mapprinter/, tile server behind it).
WEB_PORT=80

# Host port for direct access to TileServer GL (TAK raster tiles etc.).
TILESERVER_PORT=8080

# Server configuration file.
# config.json = all styles. It needs basemap, contours and hillshade mbtiles files, plus
# extras and usdata (run scripts/data-placeholders.sh for empty ones if you did not build them).
# config-basic.json = osm and overlay only. It needs only basemap.mbtiles.
TILESERVER_CONFIG=config.json

# TileServer GL image, built for both x86 (amd64) and ARM (arm64, e.g. a Raspberry Pi
# on 64-bit Raspberry Pi OS). The full image renders the raster tiles TAK clients use.
TILESERVER_IMAGE=maptiler/tileserver-gl:v5.7.0

# Most memory the tile server may use (no swap on top). Raster tiles for TAK clients are what
# use it; past this, Docker restarts the tile server instead of letting it starve the machine.
# scripts/mem-limit.sh sets this from the machine's RAM: 1g under 8 GB, 0 (no cap) at 8 GB or
# more. Uncomment to choose yourself. Without a value, the cap is 1g.
# TILESERVER_MEM_LIMIT=1g

# The route service (brouter/: routes along roads and trails on the map in the browser). It works
# out one leg of a route at a time; a leg of hundreds of kilometers needs minutes more than memory.
# ROUTE_TIMEOUT: seconds before it gives up on a leg (300; at most 900, the web server's wait).
# BROUTER_MEM_LIMIT: most memory it may use, no swap on top (768m; its Java heap is two thirds of
# it, and it gives memory back after a long route). Restart it after a change: docker compose up -d brouter
# (docker compose -f docker-compose.pi.yml up -d brouter on a server installed with install-nginx.sh).
# ROUTE_TIMEOUT=300
# BROUTER_MEM_LIMIT=768m

# The map builder page (scripts/admin.sh, started as a service by scripts/install.sh).
# It is at /mapadmin/ on the web front (WEB_PORT above), with no port of its own. To reach
# it on a port as well, for a machine that runs no web front, set one here (not 8090:
# other software on such a box often holds that one) and the address it listens on:
# 0.0.0.0 is every network the device is on, 127.0.0.1 only the device itself.
# ADMIN_PORT=8730
# ADMIN_HOST=0.0.0.0
# A code the page asks for before it lets anyone change the maps. Without it the page is open.
# ADMIN_PIN=

# Builds on a small machine (scripts/lib.sh, tools/admin-server.py).
# Pi mode is on by itself on a machine with less than 8 GB of RAM; yes or no to choose. In Pi mode a build
# stays within BUILD_MEMORY, keeps Planetiler's working data on disk, computes the contour lines one cell at a
# time, uses the 30 m elevation data only, and leaves BUILD_RESERVE_GB of the drive free.
# PI_MODE=yes
# The most RAM a build may use, swap included (every build container; one runs at a time). 3072m (3.0 GB) in Pi mode;
# no cap otherwise unless set here.
# BUILD_MEMORY=3072m
# Free space (GB) a build leaves on the data drive for the system: 5 in Pi mode, 0 otherwise.
# BUILD_RESERVE_GB=5
# Services the Map Builder stops while it builds, to free RAM, and starts again when the build ends (also
# when it fails, is canceled, or a reboot ended it). systemd services by name, Docker containers as
# docker:<name>, separated by spaces. The page warns before and during a build. The web server, SSH, the
# network, Docker and fieldmap-server's own services are never stopped, even when named here.
# FIELDMAP_PAUSE_UNITS="jellyfin calibre-web docker:<container>"

# Remote access for the Fieldmap Android app (scripts/remote.sh, run by the installers). All optional.
# The gateway's port on this machine; the router forwards an outside port to it.
# Chosen at random by the first setup, between 20000 and 60999, and written here; set it yourself only to choose.
# REMOTE_PORT=
# A code that pairing a phone, and removing one, then ask for. Set it where strangers can join the network.
# REMOTE_PIN=
# An address of your own for the gateway (a port you forwarded, a name of yours), offered to phones first.
# REMOTE_ADDRESS=tak.example.com:8443
# off: do not ask the router to open a port.
# REMOTE_DIRECT=off
# off: no firewall on this box (scripts/firewall.sh, put up by every install). Only for a machine that serves
# other things to the internet: without it, nothing from outside the local network and VPNs gets an answer.
# REMOTE_FIREWALL=off
# Ports the box's firewall leaves open from outside the local network besides the gateway. None by default:
# also SSH is then reachable only from the local network. 22 opens SSH from outside; several: 22,443
# REMOTE_FIREWALL_ALLOW=22
# The Fieldmap app, kept on the box for devices to install from the Devices page (scripts/app.sh).
# off: the installers do not download it from GitHub (add a file by hand with ./scripts/app.sh add <file.apk>).
# APP_FETCH=off
# Where the app's releases are published, as <owner>/<repo> on GitHub.
# APP_REPO=Sentinel6Systems/fieldmap-android
# tailscale: also reach the gateway through Tailscale Funnel (sign the box in first: sudo tailscale up).
# REMOTE_RELAY=tailscale
# NetBird, a second way in for a box whose router cannot open a port, is set up on the Remote access page (Admin), not
# here: the setup key is kept in data/remote/netbird/. NetBird's client image, if you need another one (the compose
# files name a version, pinned by its digest):
# NETBIRD_IMAGE=netbirdio/netbird@sha256:<digest>
# The gateway's image, likewise:
# REMOTE_IMAGE=nginx@sha256:<digest>

# Set by scripts/install-nginx.sh from its environment (see pi/README.md), read by the services and the other scripts:
# the data folder outside this repository, the folder for the nginx snippets, a ports file for the machine's own
# firewall, the host name for the checks, and the user the services run as.
# FIELDMAP_DATA=/srv/maps
# FIELDMAP_NGINX_DIR=/etc/nginx/fieldmap.d
# FIELDMAP_PORTS_FILE=/etc/<host-firewall>/fieldmap.ports
# FIELDMAP_SERVER_NAME=<server-name>
# FIELDMAP_USER=fieldmap
# The user the Map Builder runs as (install-nginx.sh; default: the owner of the data folder).
# FIELDMAP_BUILD_USER=<user>
