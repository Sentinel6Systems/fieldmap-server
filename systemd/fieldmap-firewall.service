# fieldmap-server: the firewall on the box itself (scripts/firewall.sh): only the local network
# and VPNs get in. Installed by scripts/firewall.sh install (run by the installers), which fills
# in this folder.
[Unit]
Description=fieldmap-server firewall on this box
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/fieldmap-server/scripts/firewall.sh apply
