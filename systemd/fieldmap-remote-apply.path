# Applies a new gateway port chosen on the Remote access page ("New random port"): the service writes
# it to .env and touches data/remote/apply-request, and this runs scripts/remote.sh setup, which
# moves the gateway, the firewall and the service to it. Installed by scripts/remote.sh setup.
[Unit]
Description=fieldmap-server applies a new remote gateway port

[Path]
PathChanged=/opt/fieldmap-server/data/remote/apply-request
Unit=fieldmap-remote-apply.service

[Install]
WantedBy=paths.target
