# Systemd unit for the tile server.
# This unit starts the Docker Compose stack at boot.
#
# Install steps:
# 1. Copy this file to /etc/systemd/system/tileserver.service
# 2. Edit WorkingDirectory. Set it to your clone of this repository.
# 3. Run: sudo systemctl daemon-reload
# 4. Run: sudo systemctl enable --now tileserver

[Unit]
Description=TileServer GL (Docker Compose)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/tileserver
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
