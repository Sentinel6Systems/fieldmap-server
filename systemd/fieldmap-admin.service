# Systemd unit for the map builder page (scripts/admin.sh): it keeps the page available,
# now and after a reboot.
#
# scripts/install.sh installs this file with WorkingDirectory, User and ExecStart set to
# your clone of this repository and its owner (a member of the docker group). By hand:
# 1. Copy this file to /etc/systemd/system/fieldmap-admin.service
# 2. Edit WorkingDirectory, User and ExecStart.
# 3. Run: sudo systemctl daemon-reload
# 4. Run: sudo systemctl enable --now fieldmap-admin
#
# The page is served at /mapadmin/ by the web front. Its optional PIN and optional own port
# are read from .env (see .env.example).

[Unit]
Description=fieldmap-server map builder page
After=network-online.target docker.service
Wants=network-online.target

[Service]
WorkingDirectory=/opt/tileserver
User=tileserver
ExecStart=/opt/tileserver/scripts/admin.sh
Restart=on-failure
# A running build is its own process: stopping the page does not stop it.
KillMode=process

[Install]
WantedBy=multi-user.target
