{
  "options": {
    "paths": {
      "root": "",
      "fonts": "fonts",
      "styles": "styles",
      "mbtiles": "data"
    },
    "maxScaleFactor": 2,
    "minRendererPoolSizes": [0, 0],
    "maxRendererPoolSizes": [2, 1]
  },
  "styles": {
    "osm": {
      "style": "osm.json",
      "serve_rendered": true
    },
    "topo-light": {
      "style": "topo-light.json",
      "serve_rendered": true
    },
    "topo-dark": {
      "style": "topo-dark.json",
      "serve_rendered": true
    },
    "overlay": {
      "style": "overlay.json",
      "serve_rendered": true
    },
    "topo-print": {
      "style": "topo-print.json",
      "serve_rendered": true
    },
    "topo-usgs": {
      "style": "topo-usgs.json",
      "serve_rendered": true
    },
    "topo-usgs-12k": {
      "style": "topo-usgs-12k.json",
      "serve_rendered": false
    },
    "topo-usgs-24k": {
      "style": "topo-usgs-24k.json",
      "serve_rendered": false
    },
    "topo-usgs-50k": {
      "style": "topo-usgs-50k.json",
      "serve_rendered": false
    },
    "topo-usgs-100k": {
      "style": "topo-usgs-100k.json",
      "serve_rendered": false
    }
  },
  "data": {
    "basemap": {
      "mbtiles": "basemap.mbtiles"
    },
    "contours": {
      "mbtiles": "contours.mbtiles"
    },
    "hillshade": {
      "mbtiles": "hillshade.mbtiles",
      "sparse": false
    },
    "extras": {
      "mbtiles": "extras.mbtiles"
    },
    "usdata": {
      "mbtiles": "usdata.mbtiles"
    }
  }
}
